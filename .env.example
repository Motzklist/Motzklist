# ==============================================================================
# Motzklist — environment variables for docker-compose.prod.yml
# ==============================================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Docker Compose auto-loads `.env` from this directory. Do NOT commit `.env`.
# ==============================================================================

# --- Required ---------------------------------------------------------------

# Secret used to sign admin session cookies. Use a long, random string.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Password for the PostgreSQL database (used by both backend and database).
DB_PASSWORD=

# --- Optional ---------------------------------------------------------------

# Allowed origin for CORS on the backend. Defaults to http://localhost:3000.
CLIENT_ORIGIN=http://localhost:3000

# Stripe secret key for payment processing. Leave empty to disable.
STRIPE_SECRET_KEY=
